{
  "name": "whatsapp-mcp",
  "version": "1.0.0",
  "description": "Local-only WhatsApp connector (MCP server) for Claude Desktop, built on Baileys.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "setup": "node dist/cli/setup.js",
    "quickstart": "npm run build && node dist/cli/setup.js --claude && node dist/listener/index.js --link",
    "link": "node dist/listener/index.js --link",
    "start": "node dist/cli/service.js start",
    "stop": "node dist/cli/service.js stop",
    "status": "node dist/cli/status.js",
    "relink": "node dist/cli/relink.js",
    "kill": "node dist/cli/killswitch.js on",
    "unkill": "node dist/cli/killswitch.js off",
    "drafts": "node dist/cli/drafts.js",
    "install-service": "node dist/cli/service.js install",
    "uninstall-service": "node dist/cli/service.js uninstall",
    "mcp": "node dist/mcp/index.js",
    "chats": "node dist/cli/chats.js",
    "pretest": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realgrowthnexus/whatsapp-mcp.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/realgrowthnexus/whatsapp-mcp/issues"
  },
  "homepage": "https://github.com/realgrowthnexus/whatsapp-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "baileys": "7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
